# Example environment variables for the React frontend

# Base URL for the backend API.
# - Local development: leave empty to use CRA proxy to http://localhost:3001
# - Preview/Production: set to your remote backend URL (e.g., https://<host>:3001)
# If not set in non-development environments, the app will default to:
# https://vscode-internal-33523-beta.beta01.cloud.kavia.ai:3001
REACT_APP_API_BASE_URL=
